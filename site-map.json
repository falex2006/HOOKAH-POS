    {"view":"auto-orders","group":"inventory","title":"Пополнение запасов"},
    {"view":"movements","group":"inventory","title":"Поставки и списания"},
    {"view":"premixes","group":"inventory","title":"Заготовки и премиксы"},
    {"view":"directories","group":"inventory","title":"Цеха и категории"}
