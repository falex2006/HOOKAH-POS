{
  "name": "hookah-pos",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "pg": "^8.13.1",
    "sharp": "^0.35.5"
  },
  "scripts": {
    "qa:local:setup": "node scripts/local-full-qa-setup.cjs",
    "qa:local:serve": "node scripts/local-full-qa-server.cjs",
    "qa:local:seed": "node scripts/seed-local-full-qa.mjs --config tmp/full-local-qa/runtime.json",
    "qa:local:guards": "node scripts/local-full-qa.mjs --check-guards",
    "qa:local:full": "node scripts/local-full-qa.mjs --all",
    "qa:staff-avatar-image": "node scripts/staff-avatar-image-qa.mjs",
    "start": "node server.js",
    "db:migrate": "node scripts/migrate.js",
    "qa:tasks": "node scripts/tasks-qa.mjs",
    "qa:inventory": "node scripts/inventory-hierarchy-contract.mjs && node scripts/inventory-subdepartment-api-qa.mjs",
    "qa:security": "node scripts/security-default-credential-qa.mjs && node scripts/security-qa.mjs",
    "qa:warehouse": "node scripts/warehouse-qa.mjs",
    "qa:payroll": "node scripts/payroll-qa.mjs",
    "qa:orders": "node scripts/order-attention-qa.mjs",
    "qa:postgres": "node scripts/postgres-qa.mjs",
    "qa:header": "node scripts/header-shell-contract.mjs",
    "qa:trusted-pin": "node scripts/trusted-pin-return-contract.mjs && node scripts/trusted-pin-return-runtime-qa.mjs",
    "qa:notifications:api": "node scripts/notifications-api-qa.mjs",
    "qa:notifications:browser": "node scripts/notifications-browser-qa.mjs",
    "qa:notifications:postgres": "node scripts/notifications-postgres-qa.mjs",
    "qa:shifts:notifications": "node scripts/shift-notifications-e2e-qa.mjs",
    "qa:shifts:state": "node scripts/shift-state-runtime-qa.mjs",
    "db:seed-menu": "node scripts/seed-menu-catalog.js"
